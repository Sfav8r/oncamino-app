{
  "appId": "app.oncamino",
  "appName": "OnCamino",
  "webDir": "www",
  "appendUserAgent": "OnCaminoApp/1.0",
  "backgroundColor": "#011F40",
  "server": {
    "url": "https://theslowluxurylife.com/live-camino-francais-map/?app=1",
    "errorPath": "index.html",
    "allowNavigation": ["theslowluxurylife.com", "*.theslowluxurylife.com"]
  },
  "android": {
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "never",
